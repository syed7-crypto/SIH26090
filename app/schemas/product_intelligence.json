{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artisan Product Intelligence",
  "description": "Shared data contract for the SIH26090 AI-driven artisan cataloging system.",
  "type": "object",
  "required": [
    "product_id",
    "media",
    "product",
    "voice",
    "pricing"
  ],
  "properties": {
    "product_id": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "required": [
        "images",
        "available_types",
        "missing_types",
        "media_readiness_score"
      ],
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "image_id",
              "storage_path",
              "quality_score",
              "blur_score",
              "brightness_score",
              "is_duplicate",
              "photo_type",
              "is_recommended_primary"
            ],
            "properties": {
              "image_id": {
                "type": "string"
              },
              "storage_path": {
                "type": "string"
              },
              "quality_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "blur_score": {
                "type": "number"
              },
              "brightness_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "is_duplicate": {
                "type": "boolean"
              },
              "photo_type": {
                "type": "string",
                "enum": [
                  "primary",
                  "lifestyle",
                  "detail",
                  "side_back",
                  "other"
                ]
              },
              "is_recommended_primary": {
                "type": "boolean"
              }
            }
          }
        },
        "available_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "primary",
              "lifestyle",
              "detail",
              "side_back",
              "other"
            ]
          }
        },
        "missing_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "primary",
              "lifestyle",
              "detail",
              "side_back",
              "other"
            ]
          }
        },
        "media_readiness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "recommended_primary_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "material": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "craft_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "length": {
              "type": [
                "number",
                "null"
              ]
            },
            "width": {
              "type": [
                "number",
                "null"
              ]
            },
            "height": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "weight": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "special_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production_time": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "language_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_transcript": {
          "type": [
            "string",
            "null"
          ]
        },
        "translated_transcript": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "costs": {
          "type": "object",
          "properties": {
            "material": {
              "type": "number",
              "minimum": 0
            },
            "labour": {
              "type": "number",
              "minimum": 0
            },
            "packaging": {
              "type": "number",
              "minimum": 0
            },
            "other": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "labour": {
          "type": "object",
          "properties": {
            "hours": {
              "type": "number",
              "minimum": 0
            },
            "rate_per_hour": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "desired_margin_percent": {
          "type": "number",
          "minimum": 0
        },
        "market_reference": {
          "type": "object",
          "properties": {
            "sample_size": {
              "type": "integer",
              "minimum": 0
            },
            "minimum": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            },
            "median": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "suggested_price": {
          "type": "object",
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "explanation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-output-rule": "Schema values are structural placeholders only. Return actual values when reliably available. Use null only when genuinely unavailable, [] only when there are genuinely no items, and 0 only when the actual value is zero. Never hallucinate missing information."
}
