APP_ENV=development
LOG_LEVEL=INFO
STORAGE_ROOT=data/uploads

# Gemini API Keys
GEMINI_VISION_KEY=your_gemini_api_key
GEMINI_SPEECH_KEY=your_gemini_api_key
GEMINI_CATALOG_KEY=your_gemini_api_key
GEMINI_PRICING_KEY=your_gemini_api_key

# Gemini Models
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_SPEECH_MODEL=gemini-3.5-transcribe
GEMINI_CATALOG_MODEL=gemini-3.6-flash
GEMINI_PRICING_MODEL=gemini-2.5-flash